# Copy to .env and adjust.

# Postgres connection string.
#  - Local: run `npm run db:local` (prisma dev) and paste the postgres:// URL it prints.
#  - Vercel: added automatically when you connect a Neon database (also sets DATABASE_URL_UNPOOLED).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Staff login, created by `npm run db:seed` / on first Vercel deploy. Use a strong password in production.
ADMIN_EMAIL="admin@krithickcars.in"
ADMIN_PASSWORD="KrithickDev@2026"

# Optional: set to "false" on Vercel to start with an empty showroom instead of the demo cars.
# SEED_DEMO_DATA="true"

# Vercel Blob photo storage — added automatically when you connect a Blob store on Vercel.
# Leave unset locally to store photos in ./uploads.
# BLOB_READ_WRITE_TOKEN=""
